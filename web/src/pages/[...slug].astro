---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import site from '../data/site.json'

import allPages from '../lib/pages.js'

export function getStaticPaths() {
  return allPages.map((page) => ({ params: { slug: page.slug }, props: { page } }))
}

const { page } = Astro.props
const crumbs = page.crumbs.map((c) => ({ label: c.label, href: c.href }))

/* the sidebar repeats the section of the main menu this page belongs to */
const sectionRoot = site.nav.find(
  (item) =>
    crumbs.some((c) => c.label === item.label) ||
    (crumbs[0]?.href && crumbs[0].href === item.href) ||
    page.path.startsWith(item.href + '/'),
)
const siblings = (sectionRoot?.children ?? []).filter((c) => c.label)

const strip = (html) =>
  html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160)
const description = strip(page.body) || `${page.title} — Universiteti i Shkodrës “Luigj Gurakuqi”.`
const external = (href) => /^https?:/.test(href || '')
---
<Base title={page.title} description={description} crumbs={page.slug ? crumbs : []}>
  <div class="page-head">
    <div class="container">
      <h1>{page.title}</h1>
    </div>
  </div>

  <div class="page-body">
    <div class:list={['container', 'page-layout', { 'page-layout--aside': siblings.length > 0 }]}>
      <article class="prose">
        {page.empty
          ? (
            <div class="empty-state">
              <strong>Kjo faqe është në përgatitje.</strong>
              <span>
                Përmbajtja për këtë seksion nuk është publikuar ende në faqen zyrtare të universitetit.
                Për informacion, shkruani në <a href="mailto:info@unishk.edu.al">info@unishk.edu.al</a>.
              </span>
            </div>
          )
          : <Fragment set:html={page.body} />}
      </article>

      {siblings.length > 0 && (
        <aside class="page-aside">
          <div class="aside-card">
            <h2>{sectionRoot.label}</h2>
            <ul class="aside-nav">
              {siblings.map((s) => (
                <li>
                  <a href={s.href} aria-current={s.href === page.path ? 'page' : undefined}>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="aside-card">
            <h2>Kontakt</h2>
            <ul class="aside-nav">
              <li><a href={`mailto:info@unishk.edu.al`}>info@unishk.edu.al</a></li>
              <li><a href="/kontakt">Rektorati, Sheshi 2 Prilli</a></li>
              <li><a href="/kerko">Kërko në faqe</a></li>
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>
